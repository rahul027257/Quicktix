NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/quicktix
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
ALLOWED_ORIGINS=http://localhost:3000
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
HOLD_MINUTES=10
WORKER_INTERVAL_SECONDS=60
# Run the expiry worker inside the API process (handy in development).
# In production run `npm run worker` as its own process and leave this false.
EMBED_WORKER=true
MAX_TICKETS_PER_BOOKING=10
REQUIRE_PAYMENT_SCREENSHOT=false

# Used only by `npm run seed:admin`
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@quicktix.local
ADMIN_PASSWORD=
